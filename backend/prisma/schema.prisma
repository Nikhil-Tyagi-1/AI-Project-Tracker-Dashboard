// AI Project Tracker Pro — Prisma data model (MVP)
// SQLite persistence per spec.md §6. Soft-delete via isArchived (not a status value).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums (spec.md §8.1–8.3)
// ---------------------------------------------------------------------------

enum ProjectStatus {
  PLANNED
  IN_PROGRESS
  ON_HOLD
  AT_RISK
  COMPLETED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

/// Stretch-auth role; optional on User for MVP seeding without credentials.
enum UserRole {
  MEMBER
  ADMIN
}

// ---------------------------------------------------------------------------
// User (recommended for owner/assignee filters; auth fields deferred to stretch)
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String?
  role         UserRole @default(MEMBER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ownedProjects  Project[] @relation("ProjectOwner")
  assignedTasks  Task[]    @relation("TaskAssignee")

  @@index([name])
}

// ---------------------------------------------------------------------------
// Project
// ---------------------------------------------------------------------------

model Project {
  id          String        @id @default(cuid())
  name        String
  description String?
  status      ProjectStatus @default(PLANNED)
  priority    Priority      @default(MEDIUM)
  progress    Int           @default(0)
  riskNotes   String?
  startDate   DateTime?
  endDate     DateTime?
  isArchived  Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  ownerId String
  owner   User   @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Restrict)

  tasks Task[]

  // List/filter: default queries exclude archived; composite speeds status dashboards.
  @@index([isArchived])
  @@index([status])
  @@index([priority])
  @@index([ownerId])
  @@index([createdAt])
  @@index([updatedAt])
  @@index([progress])
  @@index([isArchived, status])
  @@index([isArchived, priority])
  @@index([isArchived, ownerId])
  // Search (spec §9): case-insensitive matching is applied in the service layer.
  @@index([name])
}

// ---------------------------------------------------------------------------
// Task (Kanban column = status; sortOrder for within-column ordering)
// ---------------------------------------------------------------------------

model Task {
  id          String     @id @default(cuid())
  title       String
  description String?
  status      TaskStatus @default(TODO)
  priority    Priority   @default(MEDIUM)
  dueDate     DateTime?
  sortOrder   Int        @default(0)
  isArchived  Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Restrict)

  assigneeId String?
  assignee   User?   @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  // Board/list: project scope + column + ordering.
  @@index([projectId])
  @@index([projectId, status])
  @@index([projectId, status, sortOrder])
  @@index([projectId, isArchived])
  @@index([status])
  @@index([priority])
  @@index([assigneeId])
  @@index([isArchived])
  @@index([title])
}
