# Backend environment variables (copy to .env — never commit secrets)

# HTTP server
PORT=4000
NODE_ENV=development

# Allowed browser origin for CORS (Next.js frontend)
FRONTEND_ORIGIN=http://localhost:3000

# Prisma SQLite database (relative to the prisma/ directory)
# Developer / local app data — never point automated tests at this file.
DATABASE_URL="file:./dev.db"

# Automated tests always use an isolated ephemeral DB (prisma/test.db) via
# `npm test` / `npm run test:backend`. Do not set DATABASE_URL to dev.db when
# running Jest; the test runner overrides and refuses to touch dev.db.
